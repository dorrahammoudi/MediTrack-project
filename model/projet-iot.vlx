  "fileGroups": {
    "group-esp32": [
      {
        "name": "sketch.ino",
        "content": "#include <WiFi.h>\n#include <PubSubClient.h>\n#include <ArduinoJson.h>\n\nconst char* ssid = \"Velxio-GUEST\"; \nconst char* password = \"\";\nconst char* mqtt_server = \"broker.hivemq.com\";\nconst char* mqtt_topic = \"patients/P001/vitals\";\nconst char* command_topic = \"patients/P001/commands\"; \n\nconst int ledPin = 4;    \nconst int buzzerPin = 5; \nconst int buttonPin = 12;\n\nbool alarmAcknowledged = false; \n\nWiFiClient espClient;\nPubSubClient client(espClient);\nunsigned long lastMsg = 0;\nconst long interval = 5000;\n\nvoid callback(char* topic, byte* payload, unsigned int length) {\n  String message = \"\";\n  for (int i = 0; i < length; i++) {\n    message += (char)payload[i];\n  }\n  \n  if (message.indexOf(\"stop_alarm\") >= 0) {\n    Serial.println(\"🔕 Ordre d'acquittement reçu !\");\n    alarmAcknowledged = true; \n    digitalWrite(ledPin, LOW);\n    noTone(buzzerPin);\n  }\n}\n\nvoid setup_wifi() {\n  WiFi.mode(WIFI_STA);\n  WiFi.begin(ssid, password);\n  while (WiFi.status() != WL_CONNECTED) {\n    delay(500);\n    Serial.print(\".\");\n  }\n}\n\nvoid reconnect() {\n  while (!client.connected()) {\n    String clientId = \"ESP32Client-\";\n    clientId += String(random(0xffff), HEX);\n    if (client.connect(clientId.c_str())) {\n      Serial.println(\"MQTT connecte\");\n      client.subscribe(command_topic); \n    } else {\n      delay(5000);\n    }\n  }\n}\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(ledPin, OUTPUT);\n  pinMode(buzzerPin, OUTPUT);\n  pinMode(buttonPin, INPUT_PULLUP); \n  \n  setup_wifi();\n  client.setServer(mqtt_server, 1883);\n  client.setCallback(callback); \n}\n\nvoid loop() {\n  if (!client.connected()) reconnect();\n  client.loop();\n\n  unsigned long now = millis();\n  if (now - lastMsg > interval) {\n    lastMsg = now;\n\n    int heartRate;\n    int spo2;\n    float temperature;\n\n    // Est-ce qu'on déclenche une urgence ? (Bouton pressé OU 10% de chance)\n    bool triggerEmergency = (digitalRead(buttonPin) == LOW && !alarmAcknowledged) || (random(0, 100) < 10);\n\n    if (triggerEmergency) { \n      // 1. On commence avec des valeurs normales\n      heartRate = random(65, 96);\n      spo2 = random(96, 101);\n      temperature = random(363, 371) / 10.0; \n\n      // 2. On choisit UN SEUL problème au hasard (0, 1, 2 ou 3)\n      int emergencyType = random(0, 4); \n      \n      if (emergencyType == 0) {\n        heartRate = random(125, 150); // Cœur trop rapide\n        Serial.println(\"🚨 URGENCE : Tachycardie (Cœur rapide)\");\n      } \n      else if (emergencyType == 1) {\n        heartRate = random(35, 49); // Cœur trop lent\n        Serial.println(\"🚨 URGENCE : Bradycardie (Cœur lent)\");\n      } \n      else if (emergencyType == 2) {\n        spo2 = random(80, 89); // Manque d'oxygène\n        Serial.println(\"🚨 URGENCE : Hypoxie (Oxygène bas)\");\n      } \n      else if (emergencyType == 3) {\n        temperature = random(385, 405) / 10.0; // Forte fièvre\n        Serial.println(\"🚨 URGENCE : Hyperthermie (Fièvre)\");\n      }\n    } \n    else {\n      // Si le bouton est relâché, on réinitialise pour le prochain test\n      if (digitalRead(buttonPin) == HIGH) {\n        alarmAcknowledged = false; \n      }\n      \n      // Valeurs normales\n      heartRate = random(65, 96);\n      spo2 = random(96, 101);\n      temperature = random(363, 371) / 10.0; \n    }\n\n    // Logique d'alerte locale (Buzzer et LED)\n    if ((heartRate > 120 || heartRate < 50 || spo2 < 90 || temperature > 38.0) && !alarmAcknowledged) {\n      digitalWrite(ledPin, HIGH);   \n      tone(buzzerPin, 1000);        \n    } else {\n      digitalWrite(ledPin, LOW);    \n      noTone(buzzerPin);            \n    }\n\n    // Création et envoi du JSON\n    StaticJsonDocument<200> doc;\n    doc[\"patient_id\"] = \"P001\";\n    doc[\"heart_rate\"] = heartRate;\n    doc[\"spo2\"] = spo2;\n    doc[\"temperature\"] = temperature;\n    doc[\"timestamp\"] = millis();\n\n    char jsonBuffer[256];\n    serializeJson(doc, jsonBuffer);\n\n    client.publish(mqtt_topic, jsonBuffer);\n    Serial.print(\"Publie: \");\n    Serial.println(jsonBuffer);\n  }\n}"
      }
    ]
  },
